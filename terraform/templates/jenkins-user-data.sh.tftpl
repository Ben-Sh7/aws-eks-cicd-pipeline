#!/bin/bash
set -eo pipefail
exec > /var/log/jenkins-bootstrap.log 2>&1

apt-get update -y
apt-get install -y openjdk-21-jdk docker.io awscli git curl gnupg

# The jenkins user does not exist until the jenkins package is installed
# further down, so its docker group membership is granted there, not here -
# doing it now silently no-ops and the pipeline then fails on docker build
# with "permission denied while trying to connect to the Docker daemon socket".
usermod -aG docker ubuntu || true

# Trivy (CVE scanner) - pinned version + checksum verification, not
# curl|sh from a floating "latest" tag. Trivy's own release pipeline was
# compromised twice in 2026 via poisoned releases/tags, so a fixed,
# checksum-verified version is a deliberate choice here, not an oversight.
TRIVY_VERSION="0.74.0"
TRIVY_TARBALL="trivy_$${TRIVY_VERSION}_Linux-64bit.tar.gz"
cd /tmp
curl -fsSLO "https://github.com/aquasecurity/trivy/releases/download/v$${TRIVY_VERSION}/$${TRIVY_TARBALL}"
curl -fsSLO "https://github.com/aquasecurity/trivy/releases/download/v$${TRIVY_VERSION}/trivy_$${TRIVY_VERSION}_checksums.txt"
grep " $${TRIVY_TARBALL}\$" "trivy_$${TRIVY_VERSION}_checksums.txt" | sha256sum -c -
tar xzf "$TRIVY_TARBALL" trivy
mv trivy /usr/local/bin/trivy
chmod +x /usr/local/bin/trivy
cd /

# Jenkins rotated the apt signing key: the 2023 key (5BA31D57EF5975CA) no
# longer matches what debian-stable is signed with, and apt dies on
# "NO_PUBKEY 7198F4B714ABFC68". The key id is pinned and verified before it
# is trusted, the same way Trivy is checksum-verified above - so the next
# rotation fails loudly here instead of quietly installing an unsigned Jenkins.
JENKINS_KEY_ID="7198F4B714ABFC68"
curl -fsSL https://pkg.jenkins.io/debian-stable/jenkins.io-2026.key -o /usr/share/keyrings/jenkins-keyring.asc
FOUND_KEY=$(gpg --show-keys --with-colons /usr/share/keyrings/jenkins-keyring.asc | awk -F: '/^pub/{print $5; exit}')
if [ "$FOUND_KEY" != "$JENKINS_KEY_ID" ]; then
  echo "Jenkins apt key is $FOUND_KEY, expected $JENKINS_KEY_ID - refusing to continue"
  exit 1
fi
echo "deb [signed-by=/usr/share/keyrings/jenkins-keyring.asc] https://pkg.jenkins.io/debian-stable binary/" > /etc/apt/sources.list.d/jenkins.list
apt-get update -y
apt-get install -y jenkins

# The jenkins user exists now. It needs the docker socket because the pipeline
# builds images; granted before jenkins first starts so the process inherits
# the group.
usermod -aG docker jenkins

systemctl stop jenkins

# Skip the setup wizard - the Groovy init script below configures a real
# admin account instead, so this doesn't leave Jenkins wide open.
mkdir -p /etc/systemd/system/jenkins.service.d
cat > /etc/systemd/system/jenkins.service.d/override.conf << 'SYSTEMD_EOF'
[Service]
Environment="JAVA_OPTS=-Djenkins.install.runSetupWizard=false"
SYSTEMD_EOF
systemctl daemon-reload

# Pre-install the plugins this pipeline needs before Jenkins first starts.
JENKINS_WAR=$(find /usr/share -name jenkins.war | head -1)
mkdir -p /var/lib/jenkins/plugins
curl -fsSL -o /tmp/jenkins-plugin-manager.jar \
  https://github.com/jenkinsci/plugin-installation-manager-tool/releases/download/2.13.2/jenkins-plugin-manager-2.13.2.jar
java -jar /tmp/jenkins-plugin-manager.jar \
  --war "$JENKINS_WAR" \
  --plugin-download-directory /var/lib/jenkins/plugins \
  --plugins git github workflow-aggregator credentials-binding

# The three values the bootstrap script needs, fetched here with the instance's
# own IAM role instead of being written into this file. user-data is not a
# secure channel: every process on the host can read it back from
# http://169.254.169.254/latest/user-data, and it is shown in plain text in the
# EC2 console to anyone with DescribeInstanceAttribute.
#
# The retry is for IAM, not for the network: a role policy attached moments
# before the instance booted can take a few seconds to be usable, and a boot
# that fails on AccessDenied leaves a Jenkins with no admin password at all.
mkdir -p ${secrets_dir}
chmod 700 ${secrets_dir}

fetch_secret() {
  local secret_id="$1"
  local dest="$2"
  local i out
  for i in $(seq 1 12); do
    if out=$(aws secretsmanager get-secret-value --region ${aws_region}                --secret-id "$secret_id" --query SecretString --output text 2>/dev/null); then
      printf '%s' "$out" > "$dest"
      chmod 400 "$dest"
      return 0
    fi
    sleep 10
  done
  echo "Could not read $secret_id from Secrets Manager after 2 minutes - refusing to continue"
  exit 1
}

fetch_secret "${github_token_secret_id}" "${secrets_dir}/github-pat"
fetch_secret "${jenkins_admin_secret_id}" "${secrets_dir}/admin-password"
fetch_secret "${jenkins_webhook_secret_id}" "${secrets_dir}/webhook-secret"

# Bootstrap script: admin account, GitHub credential, and the Pipeline job.
mkdir -p /var/lib/jenkins/init.groovy.d
cat > /var/lib/jenkins/init.groovy.d/bootstrap.groovy << 'GROOVY_EOF'
${groovy_script}
GROOVY_EOF

chown -R jenkins:jenkins /var/lib/jenkins
systemctl start jenkins
