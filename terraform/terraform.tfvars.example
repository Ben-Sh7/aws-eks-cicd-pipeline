# OPTIONAL. You do not need this file.
#
# There is nothing required to fill in and nothing secret to put here. The
# domain, the repository and the GitHub token are read from AWS Secrets Manager
# at plan time (see external-config.tf and README -> "One-time setup"), so a
# clean checkout plus `aws configure` is enough to run:
#
#   terraform init && terraform plan && terraform apply
#
# What follows are overrides for people who want something other than the
# defaults. Copy to terraform.tfvars (gitignored) and uncomment what you need.
#
# NEVER put a token, a password or a webhook URL in here. Everything of that
# kind belongs in Secrets Manager, and nothing in this configuration reads it
# from a file.

# --- where ---
# aws_region  = "us-east-1"
# aws_profile = "your-aws-profile"    # normally unnecessary: `aws configure`

# --- the names of the three entries you created by hand ---
# config_secret_name       = "task-manager/config"
# secrets_secret_name      = "task-manager/secrets"
# github_token_secret_name = "task-manager/github-token"

# --- hostnames in front of the domain ---
# app_subdomain     = "app"
# argocd_subdomain  = "argocd"
# jenkins_subdomain = "jenkins"

# --- who may reach the Jenkins UI on 8080 ---
# Left unset, Terraform allows exactly the public IP the apply runs from.
# GitHub's own webhook ranges are allowed separately and never belong here.
# jenkins_ui_allowed_cidrs = ["203.0.113.4/32"]

# --- alerting ---
# The routing switch only. The webhook URL itself comes from Secrets Manager.
# enable_slack_alerts = true
# slack_channel       = "#alerts"

# --- sizing ---
# node_instance_type      = "t3.medium"
# node_desired_size       = 2
# rds_instance_class      = "db.t4g.micro"
# prometheus_retention    = "15d"
