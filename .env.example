# cp .env.example .env   (.env is gitignored - never commit real values)
# create.sh and destroy.sh auto-load it.

# AWS profile Terraform, the CLI and kubectl authenticate with. Required unless
# your credentials are on [default] - with SSO they never are.
#   aws configure list-profiles          # find yours
#   aws sso login --profile <name>       # SSO: run before create.sh
AWS_PROFILE=your-aws-profile-name

# GitHub PAT, scopes 'repo' + 'admin:repo_hook', created at
# https://github.com/settings/tokens - paste the token, not this URL.
# Step by step, including which scopes to tick and why:
#   README.md -> "Creating the GitHub token"
# Jenkins clones and pushes the image-tag bump with it; create.sh uses it to
# point the repo's push webhooks at Jenkins and ArgoCD.
TF_VAR_github_pat=ghp_xxxxxxxxxxxxxxxxxxxx

# Local docker-compose only. On AWS the DB password is generated and rotated by
# AWS in Secrets Manager, and reaches the cluster via External Secrets Operator.
POSTGRES_PASSWORD=your-strong-password-here

# OPTIONAL - Slack alerting. A Slack Incoming Webhook URL. Leave unset and
# Alertmanager stays on the chart default (alerts only reach its own UI). Set it
# and warning/critical alerts go to Slack.
#   https://api.slack.com/apps -> your app -> Incoming Webhooks -> Add New Webhook
# The URL targets a workspace + channel; TF_VAR_slack_channel below only overrides
# the channel. Lives only here and in local terraform state, never in git.
# TF_VAR_slack_webhook_url=https://hooks.slack.com/services/T0000/B0000/xxxxxxxx
# TF_VAR_slack_channel=#alerts

