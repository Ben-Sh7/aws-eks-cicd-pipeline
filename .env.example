# Copy this file to .env and fill in real values: cp .env.example .env
# .env is gitignored - it is never committed.

# --- Local Docker Compose (docker-compose.yml) ---
# Read automatically by `docker compose up` from a .env file in this same
# directory. Used for local dev/testing only (Postgres container).
# POSTGRES_USER and POSTGRES_DB are optional - docker-compose.yml falls
# back to postgres/tasksdb if they're not set. POSTGRES_PASSWORD has no
# fallback and is the only one of the three that's actually required.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-strong-password-here
POSTGRES_DB=tasksdb

# --- AWS deployment (create.sh / destroy.sh / Terraform) ---
# Auto-loaded by create.sh and destroy.sh if this file exists.
# All three below are required - Terraform has no default for them and
# will fail closed if any is missing.

# Grafana admin login password. Used by Terraform when it installs
# kube-prometheus-stack (terraform/helm-addons.tf). Pick your own value.
TF_VAR_grafana_admin_password=a-strong-password

# Jenkins admin login password. Used by the Groovy bootstrap script that
# runs on the Jenkins EC2 on first boot (terraform/templates/jenkins-init.groovy.tftpl).
# Pick your own value.
TF_VAR_jenkins_admin_password=a-strong-password

# GitHub Personal Access Token with 'repo' + 'admin:repo_hook' scopes.
# Create one at: https://github.com/settings/tokens
# Used by Jenkins (to push GitOps tag-bump commits back to this repo) and
# by create.sh (to create/update the GitHub webhook that triggers Jenkins).
TF_VAR_github_pat=ghp_xxxxxxxxxxxxxxxxxxxx
