node_modules/
*.log
.DS_Store
dist/
build/
coverage/
.idea/
.vscode/
*.swp
*.swo

# Real secrets. Unanchored, so it applies in every directory.
.env
.env.*
!.env.example

# Running the stack on this machine: docker-compose, env templates, local Helm
# values. Not part of the repository - the project deploys to AWS.
/local/

gitops/task-manager/values-secret.yaml

# Terraform artifacts. Plan files contain everything a state file does.
# The provider lock files are safe to commit and are not excluded.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash*.log
*.tfvars
*.tfvars.json

# Local working notes. The trailing /* matters: an ignored directory is never
# descended into, so "docs/" alone would make the negations below do nothing.
docs/*
!docs/architecture.png
!docs/inside-the-cluster.png
