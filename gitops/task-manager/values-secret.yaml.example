# Example only - do not commit real credentials.
# For local/demo use (e.g. minikube): copy to values-secret.yaml (gitignored),
# fill in real values, then:
#   helm upgrade --install task-manager gitops/task-manager -f values-secret.yaml

backend:
  image:
    repository: task-manager-backend
    tag: local
    pullPolicy: Never
frontend:
  image:
    repository: task-manager-frontend
    tag: local
    pullPolicy: Never

config:
  dbHost: postgres                  # your local Postgres Service
  dbSslCa: ""                       # plaintext: a local Postgres has no RDS certificate
  appUrl: http://localhost:8080     # the exact address you open in the browser

secrets:
  mode: local
  dbUser: postgres
  dbPassword: your-secure-password-here
  # At least 32 characters:
  #   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
  jwtSecret: generate-a-long-random-value
