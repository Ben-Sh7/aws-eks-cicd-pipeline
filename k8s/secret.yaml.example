# IMPORTANT: This is an example file only. Do NOT commit real credentials to GitHub.
# Copy this file to secret.yaml and replace the values with your actual secrets.
# Values must be base64 encoded.
#
# To encode a value: echo -n "your-value" | base64
# To decode a value: echo -n "encoded-value" | base64 -d
#
# RECOMMENDED: Use AWS Secrets Manager instead of storing secrets in files.
# See README.md for instructions.

apiVersion: v1
kind: Secret
metadata:
  name: app-secret
  labels:
    app: task-manager
type: Opaque
data:
  # base64 encoded: "postgres"
  DB_USER: cG9zdGdyZXM=
  # base64 encoded: "your-secure-password-here"
  DB_PASSWORD: eW91ci1zZWN1cmUtcGFzc3dvcmQtaGVyZQ==
