# cp .env.example .env   (.env is gitignored - never commit real values)
# Only used by `npm run start:dev`. Containers get these as real environment
# variables, which always take precedence over this file.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=tasksdb
DB_USER=postgres
DB_PASSWORD=

# Empty for the local Postgres. On AWS it points at the RDS CA bundle in the image.
DB_SSL_CA=

PORT=3001

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# OPTIONAL - the Google OAuth client id, the same value the frontend uses.
# Leave empty to switch Google sign-in off; username and password still work.
GOOGLE_CLIENT_ID=
