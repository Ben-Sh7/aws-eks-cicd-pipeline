# cp .env.example .env.local   (gitignored - never commit real values)
# Only used by `npm run dev`. Containers get these as real environment variables.

# The public address of this app. Google redirects back to
# ${APP_URL}/api/auth/callback, which must be registered on the OAuth client.
APP_URL=http://localhost:3000

# Where the NestJS backend listens.
BACKEND_URL=http://localhost:3001

# OPTIONAL - Google sign-in. Leave both empty to switch it off (the login page
# then shows only the username and password form). Google Cloud Console ->
# Google Auth Platform -> Clients -> OAuth client of type "Web application".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
